#!/usr/bin/env bash
# Fast checks only: rustfmt on staged Rust files, bash -n on staged shell. No cargo build, no tests.
# Skipped while merging and on `release` (pre-merge-commit owns that). Never run the full suite here.
set -eu
[ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0
[ "$(git symbolic-ref --short -q HEAD || true)" = release ] && exit 0
# rustfmt ratchet (#272): the repo is not rustfmt-clean, so a file is only held to the check when it can
# be. A new file must pass; a file that was clean at HEAD (its old path, for a rename) must stay clean;
# a file that was not clean at HEAD is skipped with a note. The staged blob is checked (on stdin), never
# the working copy, and nothing is formatted or written here.
if command -v rustfmt >/dev/null 2>&1; then
  fmt_bad=0 fmt_state=status
  git diff --cached --name-status -z -M --diff-filter=ACMR | tr '\0' '\n' | {
    while IFS= read -r tok; do
      case $fmt_state in
        status)
          case $tok in
            [ACMR]|[CR][0-9]*) fmt_status=$tok; fmt_state=path; continue ;;
            *) echo "pre-commit: cannot read the staged file list" >&2; exit 1 ;;
          esac ;;
        path)
          fmt_new=$tok fmt_old=$tok fmt_state=status
          case $fmt_status in [CR]*) fmt_old=$tok; fmt_state=newpath ;; esac
          [ $fmt_state = status ] || continue ;;
        newpath) fmt_new=$tok; fmt_state=status ;;
      esac
      case $fmt_new in *.rs) ;; *) continue ;; esac
      if git cat-file -e "HEAD:$fmt_old" 2>/dev/null && ! git cat-file blob "HEAD:$fmt_old" | rustfmt --check --edition 2021 >/dev/null 2>&1; then
        echo "$fmt_new was not rustfmt-clean before this commit, format check skipped" >&2
      elif ! git cat-file blob ":$fmt_new" | rustfmt --check --edition 2021 >/dev/null 2>&1; then
        echo "pre-commit: $fmt_new is not rustfmt-clean (run rustfmt --edition 2021 on it)" >&2
        fmt_bad=1
      fi
    done
    exit $fmt_bad
  } || exit 1
fi
git diff --cached --name-only --diff-filter=ACM -z -- '*.sh' .githooks | while IFS= read -r -d '' f; do
  if head -1 "$f" | grep -q 'sh'; then bash -n "$f" || { echo "pre-commit: syntax error in $f" >&2; exit 1; }; fi   # no `&&`: a file without a shebang must not fail the hook
done
