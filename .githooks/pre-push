#!/usr/bin/env bash
# Refuse a push to refs/heads/release unless a passing e2e stamp exists for the tree being pushed.
# Covers --no-commit merges, squash merges and fast-forwards, which skip pre-merge-commit.
set -eu
. "$(git rev-parse --show-toplevel)/tools/release-gate/lib.sh"
zero=0000000000000000000000000000000000000000
while read -r _ local_sha remote_ref _; do
  [ "$remote_ref" = refs/heads/release ] || continue
  [ "$local_sha" != "$zero" ] || continue   # deleting the branch pushes no tree
  gate_skipped "pre-push" && continue
  key=$(tree_key "$local_sha")
  stamp_ok "$key" || {
    echo "pre-push: no valid passing e2e stamp for tree $key; run tools/release-gate/e2e.sh on a clean checkout of it (docs/RELEASE.md)" >&2
    exit 1
  }
done
