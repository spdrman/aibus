#!/usr/bin/env bash
# Refuse a push to refs/heads/release unless a passing e2e stamp exists for the tree being pushed.
# Covers --no-commit merges, squash merges and fast-forwards, which skip pre-merge-commit.
#
# The push is judged with the gate files (tools/release-gate, tools/release-attest) taken from the
# REMOTE release tip, the old sha git hands this hook, never from the tree being pushed, so a topic
# that edits the gate cannot vouch for itself. The files are read with `git show` (git archive would
# drop whatever the tip's .gitattributes export-ignores). Refused unless RELEASE_E2E_SKIP='<reason>'
# (12+ characters, logged):
#   - the remote has no release yet (the one-time bootstrap), the remote release has no gate yet, or
#     deleting release;
#   - the push changes a gate file (tools/release-gate/*, tools/release-attest/*, .githooks/*);
#   - the push touches release-attest/ beyond attestation.json and its signature.
# A remote tip that is not in this clone is refused: fetch first. No fallback to refs/remotes.
# The skip record is written by this file alone: nothing from the working tree or the pushed tree is
# sourced or run on that path. This hook itself is read from the working tree (docs/RELEASE.md).
set -eu
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE   # a hook inherits git's; a decoy must not redirect us
zero=0000000000000000000000000000000000000000
gate=$(mktemp -d "${TMPDIR:-/tmp}/release-prepush.XXXXXX")
trap 'rm -rf "$gate"' EXIT
no() { echo "pre-push: refusing to push to release: $*" >&2; exit 1; }
cat >"$gate/refs"
# Each stdin line is <local ref> <local sha> <remote ref> <remote sha>. A local ref may hold spaces
# (HEAD^{/some message}), so fields are read from the END of the line. A newline inside the local ref
# splits one line into two and can plant a fake release line, so a line with fewer than 4 fields, or
# more than one line naming refs/heads/release, is refused.
if awk 'NF < 4 { bad = 1 } END { exit !bad }' "$gate/refs"; then
  no "a ref line I cannot parse (a newline inside a refspec?)."
fi
n=$(awk '$(NF-1) == "refs/heads/release"' "$gate/refs" | wc -l | tr -d ' ')
[ "$n" != 0 ] || exit 0
[ "$n" = 1 ] || no "more than one ref line names refs/heads/release (a newline inside a refspec?)."
read -r lsha tip < <(awk '$(NF-1) == "refs/heads/release" { print $(NF-2), $NF }' "$gate/refs")
common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
# $1 = treeish, $2 = dir: the plain files of the gate, byte for byte, attributes ignored
mat() {
  git ls-tree -r -z "$1" -- tools/release-gate tools/release-attest >"$gate/ls" || return 1
  while IFS= read -r -d '' rec; do
    path=${rec#*$'\t'}
    case ${rec%% *} in 100644|100755) ;; *) continue ;; esac
    mkdir -p "$2/$(dirname "$path")" && git show "$1:$path" >"$2/$path" || return 1
  done <"$gate/ls"
  for f in tools/release-gate/lib.sh tools/release-gate/e2e.sh tools/release-attest/config.sh; do [ -s "$2/$f" ] || return 1; done
}
have_gate=1
git cat-file -e "$tip^{commit}" 2>/dev/null && mat "$tip" "$gate/tree" 2>/dev/null || have_gate=0

if [ -n "${RELEASE_E2E_SKIP:-}" ]; then
  printf '%s' "$RELEASE_E2E_SKIP" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || no "RELEASE_E2E_SKIP is not valid UTF-8."
  reason=$(printf '%s' "$RELEASE_E2E_SKIP" | perl -0pe 's/[\x00-\x1f\x7f]|\xc2[\x80-\x9f\xa0]|\xe2\x80[\x80-\x8a\xa8\xa9\xaf]|\xe2\x81\x9f|\xe3\x80\x80/ /g; s/^\s+|\s+$//g')
  [ "${#reason}" -ge 12 ] || no "RELEASE_E2E_SKIP needs a real reason (12 characters or more once whitespace is trimmed)."
  waived=stamp
  case $tip in *[!0]*) ;; *) waived="$waived,bootstrap" ;; esac
  [ "$lsha" != "$zero" ] || waived="$waived,delete"
  if [ "$tip" != "$zero" ]; then
    if ! git cat-file -e "$tip^{commit}" 2>/dev/null; then waived="$waived,remote-tip-missing"
    elif [ "$have_gate" = 0 ]; then waived="$waived,remote-gate"; fi
  fi
  if [ "$tip" != "$zero" ] && [ "$lsha" != "$zero" ] && git cat-file -e "$tip^{commit}" 2>/dev/null && git cat-file -e "$lsha^{commit}" 2>/dev/null; then
    git diff --quiet "$tip" "$lsha" -- tools/release-gate tools/release-attest .githooks || waived="$waived,gate-change"
    [ -z "$(git diff --name-only "$tip" "$lsha" -- release-attest | grep -vxF -e release-attest/attestation.json -e release-attest/attestation.json.sig || true)" ] || waived="$waived,attest-extra"
  fi
  mkdir -p "$common/release-e2e"
  printf '%s skip at pre-push by %s: %s (pushed_sha=%s old_tip=%s remote_ref=refs/heads/release waived=%s user=%s branch=%s)\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git config user.email || echo unknown)" "$reason" "$lsha" "$tip" "$waived" "$(id -un)" "$(git symbolic-ref -q --short HEAD || echo detached)" \
    >>"$common/release-e2e/skips.log"
  echo "!!! RELEASE E2E GATE SKIPPED at pre-push: $reason (waived: $waived; logged in $common/release-e2e/skips.log)" >&2
  exit 0
fi
[ "$lsha" != "$zero" ] || no "deleting release needs RELEASE_E2E_SKIP='<reason>' (logged)."
[ "$tip" != "$zero" ] || no "the remote has no release branch (or I cannot see it), so this is the one-time bootstrap. Set RELEASE_E2E_SKIP='<reason>' (logged) to create it."
git cat-file -e "$tip^{commit}" 2>/dev/null || no "the remote's release tip ${tip} is not in this clone. fetch first (git fetch), then push again."
[ "$have_gate" = 1 ] || no "the remote release tip ${tip} has no release gate to judge with. If the remote release predates the gate (the first gated push), set RELEASE_E2E_SKIP='<reason>' (logged)."
git diff --quiet "$tip" "$lsha" -- tools/release-gate tools/release-attest .githooks \
  || no "this push changes the release gate files (tools/release-gate/*, tools/release-attest/*, .githooks/*). A gate change needs RELEASE_E2E_SKIP='<reason>' (logged)."
extra=$(git diff --name-only "$tip" "$lsha" -- release-attest | grep -vxF -e release-attest/attestation.json -e release-attest/attestation.json.sig || true)
[ -z "$extra" ] || no "this push touches release-attest/ beyond the attestation and its signature: $extra. RELEASE_E2E_SKIP='<reason>' if the owner asked for it."
key=$(bash -c '. "$1/tools/release-gate/lib.sh"; tree_key "$2"' _ "$gate/tree" "$lsha") || no "could not compute the tree key of ${lsha} with the remote tip's gate."
bash -c '. "$1/tools/release-gate/lib.sh"; stamp_ok "$2"' _ "$gate/tree" "$key" \
  || no "no valid passing e2e stamp for tree $key (made by the release tip's gate); run tools/release-gate/e2e.sh on a clean checkout of it (docs/RELEASE.md)"
