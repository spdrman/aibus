# Linux toolchain for the B1.1 desktop spike: Rust 1.90 (the host crate's pin), Node 22, the
# WebKitGTK 4.1 dev packages Tauri 2 links against, and a virtual X server for running the app
# headless. Sources are bind-mounted, never copied in, so one image serves gates, builds and runs:
#
#   docker build --platform linux/amd64 -f desktop/Dockerfile.linux -t aibus-desktop-linux desktop
#   docker run --rm --platform linux/amd64 -v "$PWD":/src -w /src/desktop aibus-desktop-linux \
#     sh linux.sh all
#
# See desktop/linux.sh for the steps and docs/desktop/B1.1-go-no-go.md for what they showed.
FROM rust:1.90-bookworm
# No fsync per unpacked file: a throwaway image layer gains nothing from it and it is very slow on a
# busy shared disk.
RUN echo force-unsafe-io > /etc/dpkg/dpkg.cfg.d/unsafe-io && apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libssl-dev libayatana-appindicator3-dev \
      xvfb xauth x11-utils imagemagick dbus-x11 procps ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && rustup toolchain install 1.90 --profile minimal -c clippy,rustfmt \
    && rustup toolchain install 1.89 --profile minimal -c clippy,rustfmt
ENV CARGO_TARGET_DIR=/tmp/target CARGO_INCREMENTAL=0
