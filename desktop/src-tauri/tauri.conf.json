{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aibus Desktop (spike)",
  "version": "0.0.1",
  "identifier": "org.devshell.aibus.desktop-spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "aibus Desktop", "width": 1280, "height": 800, "minWidth": 640, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
