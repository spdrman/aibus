{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aibus agent list --json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "scope",
      "path",
      "role",
      "model",
      "tools",
      "description"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "scope": {
        "enum": [
          "cli",
          "project",
          "user",
          "extra",
          "builtin"
        ]
      },
      "path": {
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "tools": {
        "type": [
          "array",
          "null"
        ]
      },
      "description": {
        "type": "string"
      }
    }
  }
}
