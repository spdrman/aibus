{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aibus workflow show --json",
  "type": "object",
  "required": ["name", "path", "description", "steps"],
  "properties": {
    "name": { "type": "string" },
    "path": { "type": "string" },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent", "prompt"],
        "properties": {
          "agent": { "type": "string" },
          "prompt": { "type": "string" },
          "gate": { "type": "string" },
          "on_fail": { "type": "string", "pattern": "^retry:[1-5]$" }
        }
      }
    }
  }
}
