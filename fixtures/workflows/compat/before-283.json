{
  "examples/workflows/build.toml": {
    "parse": {
      "description": "Plan a change, implement it, verify it",
      "name": "build",
      "preview": [
        "Plan the change step by step, naming the files to touch: INPUT",
        "Implement this plan: <summary of step 1 (plan)>",
        "Verify the change: build the project, run its tests and report the result. Task: INPUT"
      ],
      "steps": [
        {
          "agent": "plan",
          "gate": null,
          "prompt": "Plan the change step by step, naming the files to touch: {{input}}",
          "reads": [
            "input"
          ],
          "retries": 0
        },
        {
          "agent": "general",
          "gate": null,
          "prompt": "Implement this plan: {{prev.summary}}",
          "reads": [
            "prev.summary"
          ],
          "retries": 0
        },
        {
          "agent": "general",
          "gate": null,
          "prompt": "Verify the change: build the project, run its tests and report the result. Task: {{input}}",
          "reads": [
            "input"
          ],
          "retries": 2
        }
      ]
    },
    "validate": {
      "errors": [],
      "ok": true,
      "warnings": [
        {
          "field": null,
          "message": "nothing after this step reads its summary ({{prev.summary}} or {{steps.general.summary}})",
          "step": 2
        }
      ]
    }
  },
  "examples/workflows/explore.toml": {
    "parse": {
      "description": "Map the code, find the call sites, summarise",
      "name": "explore",
      "preview": [
        "Map the parts of the repository that matter for: INPUT",
        "Find the call sites and tests that touch what was found: <summary of step 1 (search)>",
        "Summarise how this works and where to start. Map: <summary of step 1 (search)> Call sites: <summary of step 2 (grep)>"
      ],
      "steps": [
        {
          "agent": "search",
          "gate": null,
          "prompt": "Map the parts of the repository that matter for: {{input}}",
          "reads": [
            "input"
          ],
          "retries": 0
        },
        {
          "agent": "grep",
          "gate": null,
          "prompt": "Find the call sites and tests that touch what was found: {{prev.summary}}",
          "reads": [
            "prev.summary"
          ],
          "retries": 0
        },
        {
          "agent": "plan",
          "gate": null,
          "prompt": "Summarise how this works and where to start. Map: {{steps.search.summary}} Call sites: {{steps.grep.summary}}",
          "reads": [
            "steps.search.summary",
            "steps.grep.summary"
          ],
          "retries": 0
        }
      ]
    },
    "validate": {
      "errors": [],
      "ok": true,
      "warnings": []
    }
  },
  "examples/workflows/fix.toml": {
    "parse": {
      "description": "Diagnose, assess risk, fix, verify",
      "name": "fix",
      "preview": [
        "Diagnose this problem and say where the cause is (file paths and line numbers): INPUT",
        "Risks of fixing it this way: <summary of step 1 (explore)>\n\nEnd your answer with one line, `RISK: LOW`, `RISK: MEDIUM` or `RISK: HIGH`.\n",
        "Make the fix. Diagnosis: <summary of step 1 (explore)> Risks to keep in mind: <summary of step 2 (plan)>",
        "Verify the fix: run the project's tests and report what passed and what failed. Problem: INPUT"
      ],
      "steps": [
        {
          "agent": "explore",
          "gate": null,
          "prompt": "Diagnose this problem and say where the cause is (file paths and line numbers): {{input}}",
          "reads": [
            "input"
          ],
          "retries": 0
        },
        {
          "agent": "plan",
          "gate": "grep -q 'RISK: HIGH' && { echo \"the risk assessment ended on RISK: HIGH\" >&2; exit 2; }; exit 0",
          "prompt": "Risks of fixing it this way: {{prev.summary}}\n\nEnd your answer with one line, `RISK: LOW`, `RISK: MEDIUM` or `RISK: HIGH`.\n",
          "reads": [
            "prev.summary"
          ],
          "retries": 0
        },
        {
          "agent": "general",
          "gate": null,
          "prompt": "Make the fix. Diagnosis: {{steps.explore.summary}} Risks to keep in mind: {{steps.plan.summary}}",
          "reads": [
            "steps.explore.summary",
            "steps.plan.summary"
          ],
          "retries": 0
        },
        {
          "agent": "general",
          "gate": null,
          "prompt": "Verify the fix: run the project's tests and report what passed and what failed. Problem: {{input}}",
          "reads": [
            "input"
          ],
          "retries": 2
        }
      ]
    },
    "validate": {
      "errors": [],
      "ok": true,
      "warnings": [
        {
          "field": "gate",
          "message": "runs a shell command after this step: grep -q 'RISK: HIGH' && { echo \"the risk assessment ended on RISK: HIGH\" >&2; exit 2; }; exit 0",
          "step": 2
        },
        {
          "field": null,
          "message": "nothing after this step reads its summary ({{prev.summary}} or {{steps.general.summary}})",
          "step": 3
        }
      ]
    }
  },
