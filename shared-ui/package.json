{
  "name": "shared-ui",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Domain-neutral React primitives and design tokens shared by aibus and iAsBuilt.",
  "workspaces": ["packages/*", "consumers/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build -w @sharedui/design-tokens && npm run build -w @sharedui/react-primitives",
    "test": "vitest run",
    "build:consumer": "npm run build -w @sharedui/aibus-smoke",
    "licences": "node scripts/licences.mjs",
    "check": "npm run build && npm test && npm run build:consumer && npm run licences"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.8"
  }
}
