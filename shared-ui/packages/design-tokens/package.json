{
  "name": "@sharedui/design-tokens",
  "version": "0.1.0",
  "description": "Domain-neutral colour, spacing and type tokens with light and dark themes, as CSS variables and typed data.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-css.mjs"
  }
}
